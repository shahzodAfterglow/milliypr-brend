# Hammasi server-only. NEXT_PUBLIC_* ishlatilmaydi. Haqiqiy qiymatlarni .env.local ga (lokal)
# va Vercel → Settings → Environment Variables ga (Sensitive) yozing. Bu faylga kalit yozmang.

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=npr_base_bot
# 1–256 belgi, faqat [A-Za-z0-9_-]. Masalan: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# "Zaxira" kanali ID'si (-100...)
BACKUP_CHAT_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cookie/nonce HMAC uchun. Yo'q bo'lsa middleware 503 qaytaradi. openssl rand -hex 32
SESSION_SECRET=
# /api/cron/daily uchun Bearer (1-bosqich)
CRON_SECRET=

APP_URL=https://pr.prompthub.uz
# Boshlang'ich adminlar, vergul bilan (Telegram raqamli ID)
ADMIN_TG_IDS=
